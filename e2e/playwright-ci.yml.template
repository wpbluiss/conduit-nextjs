# Copy this file to .github/workflows/playwright.yml
# (requires a token with the `workflows` permission to push)
#
# This workflow:
#   1. Installs deps + Playwright browsers
#   2. Runs `next build`
#   3. Starts `next start` and runs the e2e smoke suite against it
#   4. Uploads a test report artifact on failure
#
# Keeps PRs honest: build must compile AND all public pages must render.

name: E2E Smoke Tests

on:
  pull_request:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: read

jobs:
  smoke:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    env:
      # Supabase creds are needed for next build (type generation).
      # Use your existing repo secrets — tests don't hit Supabase directly.
      NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
      NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Build
        run: npm run build

      - name: Run e2e smoke tests
        run: npm run test:e2e
        env:
          CI: true

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7
