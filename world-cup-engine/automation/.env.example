# Copy this file to ".env" and fill in the values, then `docker compose up -d`.

# ---- Renderer (required) ----
# Free Pexels API key for stock background footage: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- n8n ----
# Your VPS public IP or domain (used for the n8n editor + YouTube OAuth redirect)
N8N_HOST=your_server_ip

# ---- Text-to-speech (pick one path) ----
# Option A (free, no key): edge-tts — run inside n8n via an HTTP/exec node. Nothing to set here.
# Option B (best voice, paid): ElevenLabs — set the key below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Images (optional, cheap) ----
# fal.ai for Flux Schnell stills (~$0.003/image) if you want AI images over stock footage.
FAL_API_KEY=

# ---- YouTube ----
# Do NOT put YouTube secrets here. Set up YouTube OAuth2 INSIDE the n8n UI:
#   Google Cloud Console -> enable "YouTube Data API v3" -> create OAuth client (Web app)
#   -> paste client id/secret into n8n Credentials -> authorize your channel.
# Uploads land as PRIVATE until your app passes Google's compliance audit (that's fine —
# it's the approval gate; you tap publish from the YouTube app).
