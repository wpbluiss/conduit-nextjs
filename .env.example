# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Service role key — required for /lib/supabase/admin.ts (R11 scraper pipeline,
# R4 billing webhook). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Anthropic (Claude) ---
# Required for live agent reasoning + Haiku batch enrichment.
ANTHROPIC_API_KEY=sk-ant-...

# --- ElevenLabs (R5 voice) ---
ELEVENLABS_API_KEY=

# --- Whisper STT (chat composer voice-to-text) ---
# OpenAI-compatible endpoint for Whisper transcription (/api/conduit/transcribe).
# Set OPENAI_BASE_URL to override with a compatible endpoint (e.g. Groq).
# If unset, the transcribe endpoint returns 503 and Whisper is hidden in the UI.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vercel + GitHub (R7 Engineering builds) ---
VERCEL_API_TOKEN=
GITHUB_PAT=
GITHUB_TOKEN=

# --- Stripe (R4 billing) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_TOPUP_10=price_...
STRIPE_PRICE_TOPUP_25=price_...
STRIPE_PRICE_TOPUP_50=price_...

# --- LiveKit (R12 voice room) ---
# Mint these in the LiveKit Cloud dashboard. Same values go on Vercel and on
# the Railway worker (conduit-voice-worker).
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# --- R12 worker auth ---
# Shared secret between Vercel and the Railway worker. Worker passes this in
# x-conduit-worker-secret to call /api/voice/memory-write. Random 32+ chars.
CONDUIT_WORKER_SECRET=

# --- R15 engineering worker (separate Railway service) ---
# URL Praxis API calls when starting a build. e.g. https://...up.railway.app
ENGINEERING_WORKER_URL=
# Shared secret between Vercel and the engineering worker. Praxis API mints
# HMAC-signed session tokens with this; the worker verifies. Random 32+ chars.
# Generate via: openssl rand -hex 32
ENGINEERING_WORKER_SECRET=

# OPENAI_API_KEY is intentionally NOT here. Lives on the Railway worker only
# (Realtime API costs stay isolated from the Vercel surface).

# --- Praxis fleet ---
# Shared secret for internal Praxis API routes (/api/conduit/vapi-context, /api/vapi).
# Must match the PRAXIS_CRON_SECRET stored in conduit_secrets (used by Supabase edge fns).
# Generate via: openssl rand -hex 32
PRAXIS_CRON_SECRET=

# --- Transactional email (Resend) ---
# Get your key at resend.com. Add RESEND_FROM_EMAIL as a verified sender.
# If unset, emails are skipped (logged to console only).
#
# SUPABASE_AUTH_HOOK_SECRET: set this to a random 32+ char string.
# Same value goes in Supabase dashboard → Auth → Hooks → Send Email → Signing secret.
# Generate: openssl rand -hex 32
SUPABASE_AUTH_HOOK_SECRET=
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Praxis <noreply@conduitai.io>

# --- Sentry (error tracking + performance) ---
# Public DSN — safe to expose; used client-side + server-side.
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Server-only override DSN (optional — falls back to NEXT_PUBLIC_SENTRY_DSN).
SENTRY_DSN=
# Build-time only — used for source map upload. Never commit. Set in Vercel env.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=conduit-nextjs

# --- Misc ---
DEPLOY_SECRET=
VERCEL_OIDC_TOKEN=
